@model IEnumerable<TaskTrackerWeb.Models.TaskItem>

@{
    ViewData["Title"] = "Task Dashboard";
    var totalTasks = Model.Count();
    var pendingTasks = Model.Count(t => t.Status == "Pending");
    var inProgressTasks = Model.Count(t => t.Status == "In Progress");
    var completedTasks = Model.Count(t => t.Status == "Completed");
}

<!-- Stat Cards Dashboard -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-primary text-white">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-semibold mb-1 small">Total Tasks</h6>
                    <h2 class="mb-0 fw-bold">@totalTasks</h2>
                </div>
                <i class="bi bi-card-checklist fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-warning text-dark">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-dark-50 text-uppercase fw-semibold mb-1 small">Pending</h6>
                    <h2 class="mb-0 fw-bold">@pendingTasks</h2>
                </div>
                <i class="bi bi-clock-history fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-info text-white">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-semibold mb-1 small">In Progress</h6>
                    <h2 class="mb-0 fw-bold">@inProgressTasks</h2>
                </div>
                <i class="bi bi-arrow-repeat fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-success text-white">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-semibold mb-1 small">Completed</h6>
                    <h2 class="mb-0 fw-bold">@completedTasks</h2>
                </div>
                <i class="bi bi-check-circle fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Action Bar -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold m-0"><i class="bi bi-kanban me-2 text-primary"></i>Tasks Overview</h3>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-3 px-4">
        <i class="bi bi-plus-lg me-1"></i> New Task
    </a>
</div>

<!-- Modern Task Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="text-muted mt-2">No tasks found. Click <strong>+ New Task</strong> to create one!</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr class="text-secondary small text-uppercase fw-semibold">
                            <th class="ps-4">Title</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@item.Title</td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
                                    <i class="bi bi-tag me-1"></i>@item.Category
                                </span>
                            </td>
                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i> Completed
                                    </span>
                                }
                                else if (item.Status == "In Progress")
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-arrow-repeat me-1"></i> In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill text-dark">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                    </span>
                                }
                            </td>
                            <td class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>@item.CreatedAt.ToString("MMM dd, yyyy - h:mm tt")
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(item.Status == "Completed" ? "btn-outline-warning" : "btn-outline-success") rounded-2 me-1">
                                        @if (item.Status == "Completed")
                                        {
                                            <i class="bi bi-arrow-counterclockwise me-1"></i><span>Reopen</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-lg me-1"></i><span>Done</span>
                                        }
                                    </button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-2 me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-2">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>