@model TaskTrackerWeb.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 mt-3">
            <div class="card-header bg-danger text-white p-3 rounded-top-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h4>
            </div>
            <div class="card-body p-4">
                <p class="fs-5 text-secondary mb-4">Are you sure you want to permanently remove this task?</p>
                <div class="bg-light p-3 rounded-3 mb-4 border">
                    <h5 class="fw-bold text-dark">@Model.Title</h5>
                    <p class="mb-1"><strong>Category:</strong> @Model.Category</p>
                    <p class="mb-1"><strong>Status:</strong> @Model.Status</p>
                    <p class="mb-0 text-muted small"><strong>Created:</strong> @Model.CreatedAt.ToString("g")</p>
                </div>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger rounded-3 px-4"><i class="bi bi-trash me-1"></i> Delete Task</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>