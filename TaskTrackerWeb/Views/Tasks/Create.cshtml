@model TaskTrackerWeb.Models.TaskItem

@{
    ViewData["Title"] = "Create Task";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 mt-3">
            <div class="card-header bg-primary text-white p-3 rounded-top-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Create New Task</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3" placeholder="e.g. Finish Sprint Report" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label fw-semibold"></label>
                        <input asp-for="Category" class="form-control rounded-3" placeholder="e.g. School, Work, Personal" />
                    </div>
                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select rounded-3">
                            <option value="Pending">Pending</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
                        <button type="submit" class="btn btn-success rounded-3 px-4"><i class="bi bi-check-lg me-1"></i> Save Task</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>